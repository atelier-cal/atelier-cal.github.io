  <!-- 3D MODAL -->
  <div id="viewer3D" class="viewer3d-overlay" onclick="close3D(event)">
    <div class="viewer3d-box">
      <button class="viewer3d-close" onclick="close3D(null, true)">✕</button>
      <div class="recenter-hint">⌖</div>

      <model-viewer
        id="model3d"
        src=""
        camera-controls
        auto-rotate
        interaction-prompt="none"
        environment-image="neutral"
        exposure="1.05"
        shadow-intensity="0.35"
        camera-orbit="0deg 75deg 4m"
        field-of-view="30deg"
        style="width:100%; height:100%; background: radial-gradient(circle at center, #1a1a1a, #000);">
        <div slot="poster" style="color:white;opacity:.85;font-family:Arial;padding:14px;">
          Loading 3D model…
        </div>
      </model-viewer>
    </div>
  </div>

  <script>
    const DEFAULT_ORBIT = "0deg 75deg 4m";
    const DEFAULT_FOV = "30deg";

    function open3D(glbPath){
      const overlay = document.getElementById('viewer3D');
      const model = document.getElementById('model3d');

      overlay.style.display = 'flex';
      document.body.style.overflow = 'hidden';

      model.autoRotate = true;
      model.cameraOrbit = DEFAULT_ORBIT;
      model.fieldOfView = DEFAULT_FOV;
      if (model.jumpCameraToGoal) model.jumpCameraToGoal();

      model.src = '';

      requestAnimationFrame(() => {
        model.src = glbPath + '?v=' + Date.now();

        const onLoad = () => {
          model.cameraOrbit = DEFAULT_ORBIT;
          model.fieldOfView = DEFAULT_FOV;
          model.autoRotate = true;
          model.removeEventListener('load', onLoad);
        };
        model.addEventListener('load', onLoad);
      });
    }

    function close3D(e, force){
      if (!force && e && e.target && e.target.id !== 'viewer3D') return;

      const model = document.getElementById('model3d');
      model.autoRotate = false;
      model.src = '';
      model.cameraOrbit = DEFAULT_ORBIT;
      model.fieldOfView = DEFAULT_FOV;

      document.getElementById('viewer3D').style.display = 'none';
      document.body.style.overflow = '';
    }

    window.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape') close3D(null, true);
    });

    /* Premium pulse on viewport entry */
    (function(){
      const targets = document.querySelectorAll('.img-wrap.has-3d');
      if (!('IntersectionObserver' in window) || targets.length === 0) return;

      const pulseOnce = (el) => {
        el.classList.remove('pulse');
        void el.offsetWidth;
        el.classList.add('pulse');
      };

      const io = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) pulseOnce(entry.target);
        });
      }, { threshold: 0.45 });

      targets.forEach(t => io.observe(t));

      let tmr;
      window.addEventListener('scroll', () => {
        clearTimeout(tmr);
        tmr = setTimeout(() => {
          targets.forEach(el => {
            const r = el.getBoundingClientRect();
            const mid = window.innerHeight * 0.55;
            if (r.top < mid && r.bottom > mid) pulseOnce(el);
          });
        }, 160);
      }, { passive: true });
    })();
  </script>
