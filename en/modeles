<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-K4502PGZ0X"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-K4502PGZ0X');
  </script>

  <meta charset="UTF-8" />
  <title>Available Roller Models | Atelier CAL</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <meta name="description" content="Discover Atelier CAL roller models (bronze). View each candy shape in 3D and request a quote for standard or custom designs." />
  <meta name="keywords" content="bronze rollers, candy rollers, confectionery rollers, custom candy mold, 3D candy model" />
  <meta name="author" content="Atelier CAL" />

  <!-- viewer 3D (model-viewer) -->
  <script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>

  <style>
    :root{
      --text: rgba(255,255,255,0.92);
      --muted: rgba(255,255,255,0.75);
      --line: rgba(255,255,255,0.18);
      --line2: rgba(255,255,255,0.28);
      --card: rgba(255,255,255,0.04);
    }

    *{ box-sizing:border-box; }

    body{
      margin:0;
      font-family: Arial, Helvetica, sans-serif;
      color: var(--text);
      background: radial-gradient(circle at top, #1c1c1c 0%, #0b0b0b 45%, #000 100%);
    }

    .container{
      width: min(1120px, 92vw);
      margin: 0 auto;
    }

    /* Avoid default blue links */
    a[href^="mailto"], a[href^="tel"], a[href^="https://wa.me"], .contact a{
      color: rgba(255,255,255,0.65);
      text-decoration: none;
    }
    a[href^="mailto"]:hover, a[href^="tel"]:hover, a[href^="https://wa.me"]:hover, .contact a:hover{
      color: rgba(255,255,255,0.92);
    }

    header{
      padding: 60px 0 18px;
      text-align:center;
    }

    h1{
      margin:0 0 10px;
      font-size: clamp(2rem, 3.4vw, 2.8rem);
      letter-spacing: .5px;
    }

    .subtitle{
      max-width: 920px;
      margin: 0 auto;
      color: var(--muted);
      line-height: 1.65;
    }

    .top-actions{
      margin-top: 18px;
      display:flex;
      gap: 12px;
      justify-content:center;
      flex-wrap: wrap;
      align-items:center;
    }

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding: 14px 22px;
      border: 1px solid var(--line2);
      color:#fff;
      text-decoration:none;
      font-size: .95rem;
      letter-spacing: .8px;
      text-transform: uppercase;
      background: transparent;
      transition: all .25s ease;
    }
    .btn:hover{
      background:#fff;
      color:#000;
      box-shadow: 0 0 20px rgba(255,255,255,0.2);
      transform: translateY(-1px);
    }

    /* Language mini-switch */
    .lang{
      display:inline-flex;
      align-items:center;
      gap:10px;
      padding: 8px 12px;
      border: 1px solid rgba(255,255,255,0.14);
      background: rgba(255,255,255,0.02);
    }
    .lang img{ height:18px; vertical-align:middle; }
    .lang a{ opacity:.9; }
    .lang a.is-active{ opacity:.55; pointer-events:none; }

    main{ padding: 30px 0 50px; }

    .grid{
      display:grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .card{
      background: var(--card);
      border: 1px solid var(--line);
      padding: 14px;
    }

    .img-wrap{
      position: relative;
      display: block;
    }

    .img{
      width: 100%;
      aspect-ratio: 1 / 1;
      background: #000;
      border: 1px solid rgba(255,255,255,0.14);
      display: block;
      object-fit: contain;
    }

    .title{
      margin: 12px 0 6px;
      font-size: 1.05rem;
      letter-spacing: .2px;
    }

    .desc{
      margin: 0;
      color: var(--muted);
      line-height: 1.55;
      font-size: .95rem;
    }

    .tag{
      margin-top: 10px;
      display:inline-block;
      padding: 6px 10px;
      border: 1px solid rgba(255,255,255,0.18);
      color: rgba(255,255,255,0.8);
      font-size: .8rem;
      letter-spacing: .6px;
      text-transform: uppercase;
    }

    .contact{
      margin-top: 26px;
      padding: 18px;
      border: 1px solid var(--line);
      background: rgba(255,255,255,0.03);
      text-align:center;
      color: var(--muted);
      line-height: 1.7;
    }

    footer{
      padding: 28px 0 38px;
      text-align:center;
      font-size: .9rem;
      color: rgba(255,255,255,0.55);
    }

    @media (max-width: 920px){
      .grid{ grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 560px){
      header{ padding-top: 50px; }
      .grid{ grid-template-columns: 1fr; }
    }

    /* ===== 3D BADGE ===== */
    .img-wrap.has-3d{ cursor: pointer; }

    .badge-3d{
      position: absolute;
      left: 12px;
      bottom: 12px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 12px;
      border-radius: 999px;
      background: rgba(0,0,0,0.62);
      border: 1px solid rgba(255,255,255,0.30);
      color: rgba(255,255,255,0.95);
      font-size: 12px;
      letter-spacing: .6px;
      text-transform: uppercase;
      backdrop-filter: blur(6px);
      pointer-events: none;
      z-index: 5;

      opacity: 0;
      transform: translateY(6px);
      transition: opacity .18s ease, transform .18s ease, box-shadow .18s ease;
    }

    .badge-3d svg{
      width: 14px;
      height: 14px;
      display:block;
      opacity: .95;
    }

    .card:hover .img-wrap.has-3d .badge-3d{
      opacity: 1;
      transform: translateY(0);
      box-shadow: 0 0 20px rgba(255,255,255,0.10);
    }

    @media (hover: none){
      .img-wrap.has-3d .badge-3d{
        opacity: .95;
        transform: none;
      }
    }

    @keyframes pulse3d {
      0%   { transform: translateY(0) scale(1); }
      35%  { transform: translateY(0) scale(1.06); }
      70%  { transform: translateY(0) scale(1); }
      100% { transform: translateY(0) scale(1); }
    }

    .img-wrap.has-3d.pulse .badge-3d{
      opacity: .98;
      transform: translateY(0);
      animation: pulse3d .85s ease-out 1;
    }

    /* ===== 3D MODAL ===== */
    .viewer3d-overlay{
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.85);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      padding: 14px;
    }

    .viewer3d-box{
      width: min(980px, 100%);
      height: min(640px, 82vh);
      background: #000;
      border: 1px solid rgba(255,255,255,0.2);
      position: relative;
      overflow: hidden;
    }

    .viewer3d-close{
      position: absolute;
      top: 10px;
      right: 10px;
      background: rgba(255,255,255,0.15);
      border: 1px solid rgba(255,255,255,0.3);
      color: #fff;
      font-size: 18px;
      padding: 6px 10px;
      cursor: pointer;
      z-index: 2;
    }
    .viewer3d-close:hover{
      background:#fff;
      color:#000;
    }

    .recenter-hint{
      position: absolute;
      bottom: 18px;
      right: 18px;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: rgba(0,0,0,0.35);
      border: 1px solid rgba(255,255,255,0.35);
      color: #fff;
      font-size: 20px;
      line-height: 40px;
      text-align: center;
      z-index: 3;
      backdrop-filter: blur(4px);
      pointer-events: none;
    }
  </style>
</head>

